{
	"name": "@emiliodominguez/tink",
	"version": "2.0.0",
	"description": "tink: strictly typed, zero-dependency, tree-shakeable TypeScript utilities for everyday JavaScript.",
	"keywords": [
		"typescript",
		"utilities",
		"helpers",
		"utils",
		"lodash-alternative",
		"functional-programming",
		"type-guards",
		"decorators",
		"debounce",
		"throttle",
		"memoize",
		"deep-clone",
		"deep-merge",
		"string-case",
		"date-utils",
		"async",
		"retry",
		"tree-shakeable",
		"zero-dependencies",
		"property-based-testing"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/js-helpers.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/js-helpers/issues"
	},
	"homepage": "https://github.com/emiliodominguez/js-helpers#readme",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"default": "./dist/*/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "yarn clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
		"dev:watch": "tsc -p tsconfig.build.json -w",
		"typecheck": "tsc --noEmit",
		"prettier": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint --fix \"src/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:tz": "node scripts/test-timezones.mjs",
		"test:docs": "node scripts/doctest.mjs",
		"test:mutation": "stryker run",
		"bench": "node scripts/bench.mjs",
		"test:dist": "node scripts/smoke-dist.mjs",
		"check:exports": "attw --pack . --profile esm-only",
		"check:size": "node scripts/check-size.mjs",
		"check:types": "node scripts/check-types.mjs",
		"docs": "typedoc",
		"docs:api": "node scripts/generate-api-docs.mjs && prettier --write docs/API.md",
		"validate": "yarn lint --max-warnings 0 && yarn format:check && yarn typecheck && yarn test:tz && yarn test:docs && yarn build && yarn test:dist && yarn check:size && yarn check:types && yarn check:exports",
		"prepare": "husky",
		"prepublishOnly": "yarn validate"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@stryker-mutator/core": "^10",
		"@stryker-mutator/jest-runner": "^10",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.43",
		"bezier-easing": "^3.2.0",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.52.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsdoc": "^65.3.2",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-unused-imports": "^4.4.1",
		"fast-check": "^4.10.2",
		"fuse.js": "^7.5.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"lodash-es": "^4.18.1",
		"mitt": "^3.0.1",
		"nanoid": "^6.0.2",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.14",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
