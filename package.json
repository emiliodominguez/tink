{
	"name": "tinkit",
	"version": "1.6.0",
	"description": "tink: strictly typed, zero-dependency, tree-shakeable TypeScript utilities for everyday JavaScript.",
	"keywords": [
		"typescript",
		"utilities",
		"helpers",
		"utils",
		"lodash-alternative",
		"functional-programming",
		"type-guards",
		"decorators",
		"debounce",
		"throttle",
		"memoize",
		"deep-clone",
		"deep-merge",
		"string-case",
		"date-utils",
		"async",
		"retry",
		"cron",
		"semver",
		"jwt",
		"server-sent-events",
		"full-text-search",
		"circuit-breaker",
		"path",
		"tree-shakeable",
		"zero-dependencies",
		"property-based-testing"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/tinkit.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/tinkit/issues"
	},
	"homepage": "https://github.com/emiliodominguez/tinkit#readme",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"default": "./dist/*/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"llms.txt",
		"llms-full.txt",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "yarn clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
		"dev:watch": "tsc -p tsconfig.build.json -w",
		"typecheck": "tsc --noEmit",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:tz": "node scripts/test-timezones.mjs",
		"test:docs": "node scripts/doctest.mjs",
		"test:stress": "jest -c jest.stress.cjs",
		"test:mutation": "stryker run",
		"bench": "node scripts/bench.mjs",
		"compare": "node bench/edge-cases.mjs",
		"test:dist": "node scripts/smoke-dist.mjs",
		"check:exports": "attw --pack . --profile esm-only",
		"check:size": "node scripts/check-size.mjs",
		"check:types": "node scripts/check-types.mjs",
		"check:treeshaking": "node scripts/check-treeshaking.mjs",
		"docs": "typedoc",
		"docs:api": "node scripts/generate-api-docs.mjs && oxfmt docs/API.md",
		"docs:sizes": "node scripts/generate-size-docs.mjs && oxfmt docs/SIZES.md docs/MIGRATING-FROM-LODASH.md",
		"validate": "yarn lint --max-warnings 0 && yarn format:check && yarn typecheck && yarn test:tz && yarn test:docs && yarn build && yarn test:dist && yarn check:size && yarn check:treeshaking && yarn check:types && yarn check:exports",
		"prepare": "husky",
		"prepublishOnly": "yarn validate"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"oxlint --fix --max-warnings 0",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{json,jsonc,md,yml,yaml,html,css}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@standard-schema/spec": "^1.1.0",
		"@stryker-mutator/core": "^10",
		"@stryker-mutator/jest-runner": "^10",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bezier-easing": "^3.2.0",
		"bytes": "^3.1.2",
		"date-fns": "^4.4.0",
		"defu": "^6.1.7",
		"es-toolkit": "^1.52.0",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.2",
		"fast-json-stable-stringify": "^2.1.0",
		"fuse.js": "^7.5.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"lodash-es": "^4.18.1",
		"mitt": "^3.0.1",
		"nanoid": "^6.0.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"p-map": "^7.1.1",
		"p-queue": "^10.0.0",
		"p-throttle": "^8.1.1",
		"radash": "^12.1.1",
		"remeda": "^2.52.0",
		"semver": "^7.8.5",
		"ts-jest": "^29.4.15",
		"typedoc": "^0.28.20",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"ufo": "^1.6.4",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	}
}
