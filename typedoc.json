{
	"$schema": "https://typedoc.org/schema.json",
	"name": "tink",
	"entryPoints": [
		"src/arrays",
		"src/async",
		"src/cache",
		"src/color",
		"src/date",
		"src/decorators",
		"src/easing",
		"src/emitter",
		"src/format",
		"src/functions",
		"src/guards",
		"src/iterables",
		"src/math",
		"src/objects",
		"src/random",
		"src/search",
		"src/store",
		"src/strings",
		"src/url",
		"src/validate",
		"src/utils"
	],
	"entryPointStrategy": "expand",
	"exclude": ["**/*.spec.ts", "src/utils/assert.ts"],
	"tsconfig": "tsconfig.build.json",
	"out": "docs/reference",
	"readme": "README.md",
	"excludePrivate": true,
	"excludeInternal": true,
	"githubPages": true
}
